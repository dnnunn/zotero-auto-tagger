{
  "name": "zotero-auto-tagger",
  "version": "0.4.0",
  "description": "Auto-tagging for Zotero. Generates keyword tags from PubMed MeSH terms for biomedical content and a local LLM via Ollama for everything else. No API key required.",
  "author": "David Nunn",
  "license": "MIT",
  "homepage": "https://github.com/dnnunn/zotero-auto-tagger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnnunn/zotero-auto-tagger.git"
  },
  "bugs": {
    "url": "https://github.com/dnnunn/zotero-auto-tagger/issues"
  },
  "keywords": [
    "zotero",
    "plugin",
    "reference-manager",
    "auto-tagging",
    "pubmed",
    "mesh-terms",
    "artificial-intelligence",
    "research-tools",
    "bibliography",
    "ollama",
    "local-llm"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "package": "node scripts/package.js",
    "all": "npm run clean && npm run build && npm run package",
    "clean": "rm -rf build"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.5",
    "fs-extra": "^11.2.0",
    "replace-in-file": "^8.3.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
